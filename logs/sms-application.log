            fc.receipt_date AS receiptDate,
            fc.receipt_date_original AS receiptDateOriginal,
            fc.paid_fees AS paidFees,
            fc.payment_mode AS paymentMode,
            fc.data_source AS dataSource,
            fc.registration_number AS registrationNumber,
            fc.created_at AS createdAt     
        FROM
            fee_collections fc     
        WHERE
            fc.is_deleted = false       
            AND fc.receipt_date BETWEEN ? AND ?       
            AND (
                ? IS NULL 
                OR fc.payment_mode = ?
            )       
            AND (
                ? IS NULL 
                OR ? = 'IMPORTED_OLD_DATA'
            )      
        UNION
        ALL      SELECT
            fr.id AS id,
            fr.receipt_number AS receiptNo,
            CONCAT_WS(' ', a.first_name, a.middle_name, a.last_name) AS studentName,
            a.mobile_primary AS mobileNo,
            fr.receipt_date AS receiptDate,
            NULL AS receiptDateOriginal,
            fr.amount_received AS paidFees,
            fr.payment_mode AS paymentMode,
            'NEW_ENTRY' AS dataSource,
            fr.registration_number AS registrationNumber,
            fr.created_at AS createdAt     
