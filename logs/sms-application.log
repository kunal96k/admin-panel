        ) 
        AND (
            ? IS NULL 
            OR a.admission_date >= ?
        ) 
        AND (
            ? IS NULL 
            OR a.admission_date <= ?
        ) 
    ORDER BY
        a.admission_date DESC ,
        a.admission_date desc 
    limit
        ?
